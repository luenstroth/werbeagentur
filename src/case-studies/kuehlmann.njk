      "Farbsystem nach Warengruppen für die Orientierung im Kühlregal",
      "Feste Gestaltungsraster für Füllmenge, Fettgehalt und Produktabbildung",
      "Abstimmung der Gestaltung auf Discount-Preislage ohne Billiganmutung",
      "Sell-in-Kommunikation für den Handel"
    ] %}
    <li class="check-item reveal reveal-delay-{{ loop.index0 % 3 }}">
      <span class="check-icon"></span>
      <span>{{ item }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>

