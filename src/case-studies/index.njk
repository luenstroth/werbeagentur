{#- Auszeichnung der Sammlung. Speist sich aus collections.caseStudy, damit
    kuenftige Case Studies automatisch mit aufgenommen werden. JSON-LD darf
    laut Spezifikation auch im Body stehen. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": "https://luenstroth-werbeagentur.de/case-studies/",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collections.caseStudy | length }},
    "itemListElement": [
      {%- for cs in collections.caseStudy %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": {{ cs.data.title | dump | safe }},
        "url": "https://luenstroth-werbeagentur.de{{ cs.url }}"
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
}
</script>

