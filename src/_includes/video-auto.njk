{#- Stummes Autoplay, startet erst im sichtbaren Bereich. Aufruf:
    {% set video = {src: "/img/x.mp4", poster: "/img/x-poster.jpg", label: "…"} %}{% include "video-auto.njk" %} -#}
<div class="video-auto">
  <video muted loop playsinline preload="none" poster="{{ video.poster }}" aria-label="{{ video.label }}" style="width:100%;height:100%;object-fit:cover;display:block;">
    <source src="{{ video.src }}" type="video/mp4">
  </video>
  <button type="button" class="video-sound" aria-pressed="false">{{ "Sound on" if lang == "en" else "Ton an" }}</button>
</div>
<script>
(function () {
  if (window.__videoAuto) return; window.__videoAuto = true;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var on = document.documentElement.lang === 'en' ? ['Sound on', 'Sound off'] : ['Ton an', 'Ton aus'];
  function init() {
    document.querySelectorAll('.video-auto').forEach(function (box) {
      var v = box.querySelector('video'), b = box.querySelector('.video-sound');
      b.addEventListener('click', function () {
        v.muted = !v.muted;
        if (!v.muted) { v.controls = true; v.play(); }
        b.textContent = v.muted ? on[0] : on[1];
        b.setAttribute('aria-pressed', String(!v.muted));
      });
      if (reduce || !('IntersectionObserver' in window)) { v.controls = true; return; }
      new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(function () { v.controls = true; }); }
          else { v.pause(); }
        });
      }, { threshold: 0.4 }).observe(v);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
