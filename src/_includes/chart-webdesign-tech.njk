<div class="reveal" style="margin:2rem 0;">
<style>
.wd-fill { transform-origin: left; transform: scaleX(0); transition: transform 1s cubic-bezier(.16,1,.3,1); height: 100%; }
.reveal.is-visible .wd-fill { transform: scaleX(1); }
@media (prefers-reduced-motion: reduce) { .wd-fill { transition: none; transform: scaleX(1); } }
.wd-metric { margin-bottom: 2rem; }
.wd-metric-label { font-size: .9375rem; font-weight: 600; margin-bottom: .75rem; }
.wd-bar-row { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: .75rem; margin-bottom: .4rem; }
.wd-bar-name { font-size: .75rem; color: rgba(var(--ink-rgb),.6); }
.wd-track { height: 8px; background: var(--paper-3); }
</style>

{%- set metrics = [
  {name: "Ladezeit", vals: [40,40,80,100]},
  {name: "Sicherheit (weniger Angriffsfläche)", vals: [40,60,80,100]},
  {name: "Selbstständige Textpflege ohne Entwickler", vals: [100,80,60,20]},
  {name: "Große, mehrsprachige Projekte mit vielen Redakteuren", vals: [60,100,80,60]}
] -%}
{%- set names = ["WordPress","TYPO3","Headless-CMS","Statisch"] -%}
{%- for m in metrics %}
<div class="wd-metric">
  <p class="wd-metric-label">{{ m.name }}</p>
  {%- for v in m.vals %}
  <div class="wd-bar-row">
    <span class="wd-bar-name">{{ names[loop.index0] }}</span>
    <div class="wd-track"><div class="wd-fill" style="width:{{ v }}%;background:var(--accent);opacity:{{ 0.55 if loop.index0 == 0 else (0.7 if loop.index0 == 1 else (0.85 if loop.index0 == 2 else 1)) }};transition-delay:{{ loop.index0 * 0.1 }}s;"></div></div>
  </div>
  {%- endfor %}
</div>
{%- endfor %}
</div>
