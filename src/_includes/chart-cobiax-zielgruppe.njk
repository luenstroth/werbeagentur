{#- Zweisprachig: Texte hängen an "lang". Zahlenformat folgt der Sprache. -#}
{%- if lang == "en" %}
{%- set c = {
  aria: "Bar chart: target group widened from 3,717 specialist structural engineering firms to 32,097 firms by adding architectural practices; figures for Germany as an example",
  title: "Target group widened by the change of claim (Germany, as an example)",
  l1: "Previous target group: specialist structural engineering firms",
  l2: "Wider target group: the same base + architectural practices",
  n1: "3,717", plus: "+ 28,380 architectural practices",
  sum: "= 32,097 firms — the reachable target group widened roughly 8.6-fold",
  src: "Figures for Germany (BAK Federal Chamber of Architects statistics 1.1.2026: 28,380 architectural practices; Listflix company database: 3,717 structural engineering firms). Cobiax operates internationally, with a focus on the Middle East among others — no comparable chamber or register statistics exist for these markets. Germany serves here as a documented example of the structural pattern, not as Cobiax's actual market size."
} %}
{%- else %}
{%- set c = {
  aria: "Balkendiagramm: Zielgruppenausweitung von 3.717 spezialisierten Statik-Ingenieurbüros auf 32.097 Büros durch zusätzliche Architekturbüros, Zahlen für Deutschland als Beispiel",
  title: "Zielgruppenausweitung durch den Claim-Wechsel (Deutschland, exemplarisch)",
  l1: "Bisherige Zielgruppe: spezialisierte Statik-Ingenieurbüros",
  l2: "Erweiterte Zielgruppe: dieselbe Basis + Architekturbüros",
  n1: "3.717", plus: "+ 28.380 Architekturbüros",
  sum: "= 32.097 Büros — rund 8,6-fache Ausweitung der ansprechbaren Zielgruppe",
  src: "Zahlen für Deutschland (BAK Bundeskammerstatistik 1.1.2026: 28.380 Architekturbüros; Listflix-Firmendatenbank: 3.717 Statik-Ingenieurbüros). Cobiax ist international tätig, u. a. mit Schwerpunkt Naher Osten — für diese Märkte liegen keine vergleichbaren Kammer-/Registerstatistiken vor. Deutschland dient hier als beleghaftes Beispiel für das strukturelle Muster, nicht als Cobiax' tatsächliche Marktgröße."
} %}
{%- endif %}
<div class="reveal" style="margin:2.5rem 0;">
<style>
.cb-bar-fill { transform-origin: left; transform: scaleX(0); transition: transform 1.2s cubic-bezier(.16,1,.3,1); }
.reveal.is-visible .cb-bar-fill { transform: scaleX(1); }
@media (prefers-reduced-motion: reduce) { .cb-bar-fill { transition: none; transform: scaleX(1); } }
</style>
<svg viewBox="0 0 800 230" xmlns="http://www.w3.org/2000/svg" style="display:block;width:100%" role="img"
  aria-label="{{ c.aria }}">
  <title>{{ c.title }}</title>

  <text x="0" y="20" font-family="sans-serif" font-size="13" fill="#110f0e" opacity=".7">{{ c.l1 }}</text>
  <rect x="0" y="30" width="70" height="36" fill="#e4dfd9"/>
  <rect class="cb-bar-fill" style="transition-delay:.1s;" x="0" y="30" width="70" height="36" fill="#0D4F5C" fill-opacity=".85"/>
  <text x="90" y="54" text-anchor="start" font-family="serif" font-size="17" font-style="italic" fill="#110f0e">{{ c.n1 }}</text>

  <text x="0" y="120" font-family="sans-serif" font-size="13" fill="#110f0e" opacity=".7">{{ c.l2 }}</text>
  <rect x="0" y="130" width="740" height="36" fill="#e4dfd9"/>
  <rect class="cb-bar-fill" style="transition-delay:.1s;" x="0" y="130" width="70" height="36" fill="#0D4F5C" fill-opacity=".85"/>
  <rect class="cb-bar-fill" style="transition-delay:.5s;" x="70" y="130" width="600" height="36" fill="#1B7A8C" fill-opacity=".9"/>
  <line x1="70" y1="126" x2="70" y2="170" stroke="#fff" stroke-width="2" stroke-dasharray="3,3"/>
  <text x="35" y="154" text-anchor="middle" font-family="serif" font-size="11" font-style="italic" fill="#fff">{{ c.n1 }}</text>
  <text x="370" y="154" text-anchor="middle" font-family="serif" font-size="15" font-style="italic" fill="#fff">{{ c.plus }}</text>

  <text x="0" y="200" font-family="sans-serif" font-size="15" fill="#0D4F5C" font-weight="700">{{ c.sum }}</text>
  <text x="0" y="222" font-family="sans-serif" font-size="9.5" fill="#110f0e" opacity=".55">{{ c.src }}</text>
</svg>
</div>
