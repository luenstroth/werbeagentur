  <h2 class="display-md reveal reveal-delay-1" style="margin-bottom:2rem;max-width:760px;">Vier Rollouts, vier Eingriffstiefen</h2>
  <div class="grid-2" style="background:none;gap:clamp(1.5rem,2.5vw,2.5rem);">
