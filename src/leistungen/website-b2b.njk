  <h2 class="display-md reveal reveal-delay-1" style="margin-bottom:1.5rem;">Eine Website, die jedem Besucher seinen Grund gibt</h2>
  <ul class="check-list">
    {%- for item in [
      "Eine Struktur nach den Fragen der Besucher, nicht nach dem Organigramm des Unternehmens",
