<header class="hero hero--foto">
  {% respImage "img/albatros-hero.jpg", "Albatros safety shoes in splashing water", "100vw", {eager: true} %}
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <h1 class="label reveal" style="margin-bottom:1.75rem;">Advertising agency for industry, retail and branded goods</h1>
    <p class="type-claim">
      {%- for w in ["Indispensable,", "not", "interchangeable"] %}
      <span class="type-word" style="animation-delay:{{ (loop.index0 * 0.13 + 0.15) | round(2) }}s;">{{ w }}{% if loop.last %}<span class="type-dot">.</span>{% endif %}</span>{% if not loop.last %} {% endif %}
      {%- endfor %}
    </p>
    <p class="type-sub reveal reveal-delay-2">For everyone involved in the decision: engineering, purchasing, management, retail, the shopper at the shelf. Sometimes it is someone other than everyone thought.</p>
    <div class="type-meta reveal reveal-delay-2">
      <a href="#fields" class="btn-fill">Two fields, one logic</a>
